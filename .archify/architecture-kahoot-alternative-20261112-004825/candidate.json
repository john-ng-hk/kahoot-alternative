  "cards": [
    {
      "dot": "violet",
      "title": "Host flow",
      "items": [
        "Dashboard inserts a games row, then opens /host/game/[id]",
        "Lobby sets phase to quiz",
        "Next button moves the sequence; the last question sets phase to result",
        "Reveal happens when every player has answered or the 20 s timer ends",
        "Results read the game_results view"
      ]
    },
    {
      "dot": "emerald",
      "title": "Player flow",
      "items": [
        "Anonymous sign-in, then a participants row is inserted",
        "Questions and reveal follow games UPDATE events",
        "Answer is inserted into answers with its score",
        "Final screen is a static thank-you message"
      ]
    },
    {
      "dot": "rose",
      "title": "Security notes",
      "items": [
        "games insert and update require host_user_id = auth.uid()",
        "answers insert policy is with check (true): any client with the anon key can write any answer row",
        "Scores are computed in the player browser and stored without server checks"
      ]
    }
  ]
